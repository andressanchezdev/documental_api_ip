# ==========================================
# CONFIGURACIÓN DEL SERVIDOR Y RAILWAY
# ==========================================
PORT=8080
ALLOWED_ORIGINS=*
JWT_SECRET=SECRET_KEY_GESTOR_DOC

# Endpoint externo opcional de login de la DB propia (si doc-api actúa como proxy de auth)
# EXTERNAL_AUTH_URL=

# ==========================================
# CONFIGURACIÓN DE MARIADB / MYSQL
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=doc_api

# Opcional en Railway: DSN completo (tiene prioridad sobre las variables anteriores)
# DB_DSN=root:password@tcp(localhost:3306)/doc_api?charset=utf8mb4&parseTime=True&loc=Local

# ==========================================
# GOOGLE DRIVE / DOCS / SHEETS CREDENCIALES
# ==========================================
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
GOOGLE_TOKEN_PATH=token.json

# Opcional para Railway Cloud (pegar el contenido JSON en una línea para no requerir archivos físicos):
# GOOGLE_CREDENTIALS_JSON={"installed":{...}}
# GOOGLE_TOKEN_JSON={"access_token":"...","refresh_token":"..."}

# ==========================================
# ALMACENAMIENTO DE PERMISOS (FALLBACK JSON)
# ==========================================
FOLDER_PERMISSIONS_PATH=folder_permissions.json

